# --- Doorbell (GLNK) ---
GLNK_HOST=192.168.1.50            # doorbell IP (give it a DHCP reservation)
GLNK_PORT=59613
GLNK_USER=admin
GLNK_PASSWORD=change-me            # device password (the 4-digit code on this model)
GLNK_UNLOCK_CODE=change-me         # door unlock code
GLNK_UNLOCK_DELAY=1

# --- FTP receiver (the doorbell uploads snapshots here on each press) ---
FTP_PORT=2121
FTP_USER=doorbell
FTP_PASSWORD=change-me             # long random string, also typed in the doorbell web UI
FTP_ALLOWED_IP=192.168.1.50        # only the doorbell may connect (defaults to GLNK_HOST)
FTP_PASSIVE_PORTS=60000-60010
KEEP_DAYS=7                        # delete received snapshots after N days

# --- MQTT / Home Assistant ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=glnk
MQTT_PASSWORD=change-me
DEVICE_ID=doorbell
DEVICE_NAME=Doorbell               # entity ids follow it: event.doorbell_ring, button.doorbell_open_door...
LOG_LEVEL=INFO
TZ=Europe/Paris                    # log timestamps
HISTORY_SIZE=4                     # last visitors kept (pictures + times), 0 = off
